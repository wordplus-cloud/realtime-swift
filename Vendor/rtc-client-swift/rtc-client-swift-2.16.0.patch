+    /// 1.0.2 (rtc-client 1.0.12): a burst node's removal, 2026-10-20. The phone joined through the burst node's own
+    /// name, a drain moved its session to Limburg, and the burst node went; the list the burst node sent still starts
+    /// with itself.
+    @Test func nextServerAfterDrainMove() async throws {
+        let list = """
+        {"regions":[
+          {"region":"DE1","url":"wss://n-burst.de.rtc.wordplus.cloud","distance":"0","node":"ND_burst"},
+          {"region":"GRA11","url":"wss://n-fr.gra.rtc.wordplus.cloud","distance":"500000","node":"ND_fr"},
+          {"region":"DE1","url":"wss://n-lim.de.rtc.wordplus.cloud","distance":"0","node":"ND_lim"}
+        ]}
+        """
+        let regions = try #require(Mesh.regions(json: Data(list.utf8)))
+        let manager = try RegionManager(providedUrl: url("wss://n-burst.de.rtc.wordplus.cloud"))
+        await manager.setSignalRegions(regions)
+
+        // 1.0.1 left out the session's node and so gave the dead burst node's own entry
+        #expect(await manager.next(token: "t", skipNode: "ND_lim")?.node == "ND_burst")
+        await manager.resetAttempts()
+
+        let failed = try url("wss://n-burst.de.rtc.wordplus.cloud")
+        #expect(await manager.next(token: "t", skipNode: nil, skipUrl: failed, preferNode: "ND_lim")?.node == "ND_lim",
+                "the session's node first, though it comes last in the list")
+        #expect(await manager.next(token: "t", skipNode: nil, skipUrl: failed, preferNode: "ND_lim")?.node == "ND_fr",
+                "tried once: the list goes on, still without the address that failed")
+        #expect(await manager.next(token: "t", skipNode: nil, skipUrl: failed, preferNode: "ND_lim") == nil)
+
+        #expect(try Mesh.sameServer(url("wss://n-burst.de.rtc.wordplus.cloud/rtc?x=1"), url("wss://n-burst.de.rtc.wordplus.cloud")),
+                "matched by the server alone, whatever path the signal URL carries")
+        #expect(try !Mesh.sameServer(url("wss://n-lim.de.rtc.wordplus.cloud"), url("wss://n-burst.de.rtc.wordplus.cloud")))
+    }
