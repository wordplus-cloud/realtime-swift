+/// WordPlus Mesh (1.0.3): the encoder reports, as @wordplus/rtc-client's own tests have them (room/meshEncoders.test.ts).
+extension WordPlusMeshTests {
+    private func layer(_ rid: String, _ height: Int, _ encoder: String? = nil, fps: Double? = nil, limit: String? = nil,
+                       encodeMs: Double? = nil, keyFrames: Int? = nil, plis: Int? = nil) -> MeshEncoders.Outbound
+    {
+        MeshEncoders.Outbound(rid: rid, height: height, encoder: encoder, powerEfficient: nil, active: true, fps: fps, limit: limit,
+                              captured: nil, mime: "video/H264", encodeMs: encodeMs, keyFrames: keyFrames, plis: plis)
+    }
+
+    private func l(_ rid: String, _ encoder: String? = nil, hw: Bool? = nil, fps: Int? = nil, height: Int? = nil, limit: String? = nil,
+                   encodeMs: Double? = nil, keyFrames: Int? = nil, plis: Int? = nil) -> MeshEncoders.Layer
+    {
+        MeshEncoders.Layer(rid: rid, encoder: encoder, hw: hw, fps: fps, height: height, limit: limit,
+                           encodeMs: encodeMs, keyFrames: keyFrames, plis: plis)
+    }
+
+    @Test func encodersOfAnAdapter() {
+        let name = "SimulcastEncoderAdapter (OpenH264, VideoToolbox, VideoToolbox)"
+        #expect(MeshEncoders.adapterEncoders(name) == ["OpenH264", "VideoToolbox", "VideoToolbox"])
+        let read = MeshEncoders.layers(of: [layer("f", 1080, name), layer("q", 270, name), layer("h", 540, name)])
+        #expect(read?.layers == [l("q", "OpenH264", hw: false), l("h", "VideoToolbox", hw: true), l("f", "VideoToolbox", hw: true)],
+                "one encoder a layer, the smallest first")
+    }
+
+    @Test func encodersOverTheLayersThatEncode() {
+        // a camera whose 540p the server paused (dynacast): the adapter names the encoders of q and f alone
+        let name = "SimulcastEncoderAdapter (OpenH264, VideoToolbox)"
+        let read = MeshEncoders.layers(of: [layer("q", 270, name, fps: 30), layer("h", 540, name, fps: 0),
+                                            layer("f", 1080, name, fps: 29.6, limit: "none")])
+        #expect(read?.layers == [l("q", "OpenH264", hw: false, fps: 30, height: 270), l("h"),
+                                 l("f", "VideoToolbox", hw: true, fps: 30, height: 1080)])
+    }
+
+    @Test func whatHoldsALayerBack() {
+        let name = "SimulcastEncoderAdapter (libvpx, libvpx)"
+        let read = MeshEncoders.layers(of: [layer("q", 720, name, fps: 15, limit: "none"), layer("h", 1080, name, fps: 8, limit: "cpu")])
+        #expect(read?.layers[1] == l("h", "libvpx", hw: false, fps: 8, height: 1080, limit: "cpu"))
+    }
+
+    @Test func oneEncoderForEveryLayer() {
+        let name = "SimulcastEncoderAdapter (libvpx, libvpx)"
+        let read = MeshEncoders.layers(of: [layer("q", 180, name), layer("h", 360, name), layer("f", 720, name)])
+        #expect(read?.layers == [l("q", "libvpx", hw: false), l("h", "libvpx", hw: false), l("f", "libvpx", hw: false)])
+
+        #expect(MeshEncoders.layers(of: [layer("q", 270, "MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)")])?.layers ==
+            [l("q", "MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)", hw: true)])
+        #expect(MeshEncoders.encoderHardware("libvpx", powerEfficient: nil) == false)
+        #expect(MeshEncoders.encoderHardware("OpenH264", powerEfficient: nil) == false)
+        #expect(MeshEncoders.encoderHardware("libaom", powerEfficient: nil) == false)
+        #expect(MeshEncoders.encoderHardware("VideoToolbox", powerEfficient: nil) == true)
+        #expect(MeshEncoders.encoderHardware(nil, powerEfficient: true) == true)
+        #expect(MeshEncoders.encoderHardware(nil, powerEfficient: nil) == nil)
+    }
+
+    @Test func layersOfAnUnnamedEncoder() {
+        let read = MeshEncoders.layers(of: [layer("q", 180, fps: 15), layer("h", 360, fps: 15)])
+        #expect(read?.encoder == "")
+        #expect(read?.layers == [l("q", fps: 15, height: 180), l("h", fps: 15, height: 360)])
+        #expect(MeshEncoders.layers(of: []) == nil)
+    }
+
+    @Test func sinceTheLastReading() {
+        let first = MeshEncoders.sinceLast(nil, .init(encodeTime: 1, frames: 30, keyFrames: 1, plis: 0))
+        #expect(first.encodeMs == nil && first.keyFrames == nil && first.plis == nil)
+        // 10 s at 7 frames a second, 52 ms a frame, 6 key frames for 9 requests: a slow encoder in a storm of key frames
+        let storm = MeshEncoders.sinceLast(.init(encodeTime: 10, frames: 1000, keyFrames: 20, plis: 30),
+                                           .init(encodeTime: 13.64, frames: 1070, keyFrames: 26, plis: 39))
+        #expect(storm.encodeMs == 52 && storm.keyFrames == 6 && storm.plis == 9)
+        // a total the device doesn't keep, or one that went back (a sender started over), says nothing
+        let back = MeshEncoders.sinceLast(.init(frames: 100, keyFrames: 5), .init(frames: 40, keyFrames: 6))
+        #expect(back.encodeMs == nil && back.keyFrames == 1 && back.plis == nil)
+        let idle = MeshEncoders.sinceLast(.init(encodeTime: 2, frames: 10), .init(encodeTime: 2, frames: 10))
+        #expect(idle.encodeMs == nil, "no frame encoded: no time a frame")
+    }
+
+    @Test func readingsOnALayerThatEncodes() {
+        let name = "SimulcastEncoderAdapter (OpenH264, MediaFoundationVideoEncodeAccelerator (AMDh264Encoder))"
+        let read = MeshEncoders.layers(of: [layer("q", 180, name, fps: 3, encodeMs: 4.1, keyFrames: 0, plis: 0),
+                                            layer("h", 360, name, fps: 3, encodeMs: 61.5, keyFrames: 6, plis: 9),
+                                            layer("f", 720, name, fps: 0, keyFrames: 0, plis: 0)])
+        #expect(read?.layers[1] == l("h", "MediaFoundationVideoEncodeAccelerator (AMDh264Encoder)", hw: true, fps: 3, height: 360,
+                                     encodeMs: 61.5, keyFrames: 6, plis: 9))
+        #expect(read?.layers[2] == l("f"))
+    }
+
+    /// A sender's stats as libwebrtc gives them on an iPhone: three layers in VideoToolbox, the codec and the source.
+    @Test func layersFromStats() throws {
+        func outbound(_ rid: String, _ height: Int, frames: Double, time: Double) -> MeshEncoders.Stat {
+            .init(id: "OT_\(rid)", type: "outbound-rtp", values: [
+                "kind": "video", "rid": rid, "frameHeight": NSNumber(value: height), "framesPerSecond": NSNumber(value: 30.0),
+                "encoderImplementation": "SimulcastEncoderAdapter (VideoToolbox, VideoToolbox, VideoToolbox)",
+                "active": NSNumber(value: true), "qualityLimitationReason": "none", "codecId": "CO_1", "mediaSourceId": "SV_1",
+                "totalEncodeTime": NSNumber(value: time), "framesEncoded": NSNumber(value: frames),
+                "keyFramesEncoded": NSNumber(value: 2.0), "pliCount": NSNumber(value: 1.0), "firCount": NSNumber(value: 0.0),
+            ])
+        }
+        let codec = MeshEncoders.Stat(id: "CO_1", type: "codec", values: ["mimeType": "video/H264"])
+        let source = MeshEncoders.Stat(id: "SV_1", type: "media-source", values: ["kind": "video", "framesPerSecond": NSNumber(value: 29.97)])
+        let audio = MeshEncoders.Stat(id: "OT_a", type: "outbound-rtp", values: ["kind": "audio"])
+
+        let first = MeshEncoders.outbound(of: [outbound("q", 180, frames: 300, time: 0.6), outbound("h", 360, frames: 300, time: 1.2),
+                                               outbound("f", 720, frames: 300, time: 3), codec, source, audio], before: nil)
+        #expect(first.outbound.count == 3, "video layers only")
+        #expect(first.totals["f"] == .init(encodeTime: 3, frames: 300, keyFrames: 2, plis: 1))
+
+        let second = MeshEncoders.outbound(of: [outbound("q", 180, frames: 600, time: 1.2), outbound("h", 360, frames: 600, time: 2.4),
+                                                outbound("f", 720, frames: 600, time: 6), codec, source], before: first.totals)
+        let report = try #require(MeshEncoders.codecReport(second.outbound, named: nil))
+        #expect(report.codec == "h264")
+        #expect(report.captured == 30)
+        #expect(report.layers.last == l("f", "VideoToolbox", hw: true, fps: 30, height: 720, limit: nil, encodeMs: 10, keyFrames: 0, plis: 0))
+        #expect(try #require(MeshEncoders.codecReport(second.outbound, named: "vp8")).codec == "vp8", "a backup's codec by its name")
+    }
+
+    /// The report where a node reads it: a request with no message, the JSON in its field 1001, keys sorted.
+    @Test func reportInASignalRequest() throws {
+        let tracks = [MeshEncoders.TrackReport(sid: "TR_a", codecs: [.init(codec: "h264", encoder: "VideoToolbox",
+                                                                           layers: [l("q", "VideoToolbox", hw: true)], captured: 30)],
+                                               mode: .init(width: 1280, height: 720, fps: 30))]
+        let json = try #require(MeshEncoders.json(tracks))
+        #expect(String(decoding: json, as: UTF8.self) ==
+            #"{"tracks":[{"codecs":[{"captured":30,"codec":"h264","encoder":"VideoToolbox","layers":[{"encoder":"VideoToolbox","hw":true,"rid":"q"}]}],"mode":{"fps":30,"height":720,"width":1280},"sid":"TR_a"}]}"#)
+
+        let request = try Livekit_SignalRequest(serializedBytes: Mesh.lengthDelimited(MeshEncoders.field, json))
+        #expect(request.message == nil, "no message of LiveKit's")
+        #expect(Mesh.lengthDelimitedField(MeshEncoders.field, in: request.unknownFields.data) == json)
+        #expect(Mesh.lengthDelimited(MeshEncoders.field, Data(count: 300)).prefix(4) == Data([0xCA, 0x3E, 0xAC, 0x02]),
+                "the tag of field 1001, then a long one's length in two bytes")
+    }
+}
