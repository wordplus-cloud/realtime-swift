+    // A call on 2026-10-23: one sender's camera arrived at 0 kbit/s 11 times in two hours on a clean
+    // line while every viewer froze; the node couldn't tell its camera, its encoder and its sending queue apart
+    @Test func whatALayerSentAndWhatItsCodecDid() {
+        let before = MeshEncoders.Totals(frames: 1000, sent: 1000, packets: 5000, sendDelay: 10, resent: 10, huge: 1,
+                                         limits: ["none": 100, "cpu": 2, "bandwidth": 0, "other": 0], sourceFrames: 1500)
+        // 10 s: the camera gave 140 frames, the encoder made 70 and 60 went, 1.5 s held back by the CPU
+        let now = MeshEncoders.Totals(frames: 1070, sent: 1060, packets: 5500, sendDelay: 12.5, resent: 15, huge: 3,
+                                      limits: ["none": 108.5, "cpu": 3.5, "bandwidth": 0, "other": 0], sourceFrames: 1640)
+        let q = MeshEncoders.sentSince(before, now)
+        #expect(q == .init(encoded: 70, sent: 60, packets: 500, sendDelay: 2.5, resent: 5, huge: 2, limits: ["cpu": 1.5], sourceFrames: 140))
+        // the two layers of one codec: the frames its source gave once, the CPU's hold the longest, the queue averaged
+        var b2 = before
+        b2.packets = 9000
+        b2.sendDelay = 40
+        var n2 = now
+        n2.packets = 10500
+        n2.sendDelay = 41.5
+        n2.limits?["cpu"] = 2.5
+        let h = MeshEncoders.sentSince(b2, n2)
+        let sending = MeshEncoders.sendingOf([q, h])
+        #expect(sending.frames == 140)
+        #expect(sending.limitMs == .init(cpu: 1500))
+        #expect(sending.queueMs == 2)
+        #expect(sending.resent == 0.5)
+        #expect(sending.huge == 4)
+        let none = MeshEncoders.sendingOf([.init()])
+        #expect(none.frames == nil && none.limitMs == nil && none.queueMs == nil && none.resent == nil && none.huge == nil)
+        #expect(MeshEncoders.sentSince(nil, now) == .init(), "nothing from a first reading")
+    }
+
