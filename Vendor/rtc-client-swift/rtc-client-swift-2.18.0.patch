+    /// 1.0.2 (rtc-client 1.0.5): a resume waits four round trips, 5 s at least, at most the socket's timeout.
+    @Test func resumeWait() {
+        #expect(Mesh.resumeWait(rttMs: 0, cap: 10) == 5)
+        #expect(Mesh.resumeWait(rttMs: 200, cap: 10) == 5)
+        #expect(Mesh.resumeWait(rttMs: 2000, cap: 10) == 8)
+        #expect(Mesh.resumeWait(rttMs: 28000, cap: 10) == 10)
+        #expect(Mesh.resumeWait(rttMs: -1, cap: 10) == 5)
+    }
