+    @Test func refusalHeaders() {
+        #expect(MeshRefusal.retryAfter("3") == 3)
+        #expect(MeshRefusal.retryAfter(nil) == nil)
+        #expect(MeshRefusal.retryAfter("soon") == nil)
+
+        let refusal = MeshRefusal(kind: "slot", node: "ND_b", retryAfter: 2)
+        #expect(refusal.kind == "slot")
+        #expect(MeshRefusal(kind: "other", node: "", retryAfter: nil).kind == nil, "a kind it doesn't know is none")
+
+        let wrapped = LiveKitError(.network, message: "Validation request failed", internalError: LiveKitError(.network, meshRefusal: refusal))
+        #expect(wrapped.meshRefusal?.node == "ND_b", "a refusal survives the error that wraps it")
+    }
