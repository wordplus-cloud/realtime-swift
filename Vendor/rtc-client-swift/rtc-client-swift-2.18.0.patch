+    @Test func aSourceStoppingByItself() {
+        var watch = SourceWatch()
+        watch.read(frames: 100, at: 0, on: true)
+        watch.read(frames: 400, at: 10000, on: true)
+        #expect(!watch.stalled)
+        // no frame between 10 s and 20 s, nor to 30 s; frames again at 40 s
+        watch.read(frames: 400, at: 20000, on: true)
+        #expect(watch.stalled)
+        watch.read(frames: 400, at: 30000, on: true)
+        watch.read(frames: 700, at: 40000, on: true)
+        // counted from the reading before the first without frames to the last without
+        #expect(watch.take(now: 40000) == (stalls: 1, ms: 20000))
+        #expect(!watch.stalled)
+        // asked while it is stopped: its time so far, the rest next time
+        watch.read(frames: 700, at: 50000, on: true)
+        #expect(watch.take(now: 55000) == (stalls: 1, ms: 15000))
+        // it gave frames again by the next reading: what of the stop came after the ask isn't known, so nothing more
+        watch.read(frames: 900, at: 60000, on: true)
+        #expect(watch.take(now: 60000) == (stalls: 0, ms: 0))
+        // a person turning the camera off is no stop
+        watch.read(frames: 900, at: 70000, on: false)
+        watch.read(frames: nil, at: 80000, on: false)
+        #expect(!watch.stalled)
+    }
