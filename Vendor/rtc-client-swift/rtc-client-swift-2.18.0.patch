+    @Test func joinRetries() {
+        let now = Date()
+        let far = now.addingTimeInterval(60)
+
+        let full = LiveKitError(.network, meshRefusal: MeshRefusal(kind: "full", node: "ND_a", retryAfter: 2))
+        let fullIn = Mesh.joinRetry(full, deadline: far, now: now)
+        #expect(fullIn != nil && fullIn! >= 2 && fullIn! < 3, "a full mesh after its Retry-After, within a second")
+
+        let unreachable = LiveKitError(.network)
+        let unreachableIn = Mesh.joinRetry(unreachable, deadline: far, now: now)
+        #expect(unreachableIn != nil && unreachableIn! >= 1 && unreachableIn! < 3)
+
+        #expect(Mesh.joinRetry(LiveKitError(.validation), deadline: far, now: now) == nil, "a refused token isn't tried again")
+        #expect(Mesh.joinRetry(full, deadline: now.addingTimeInterval(1), now: now) == nil, "not past the deadline")
+    }
