+import Foundation
+@testable import LiveKit
+import Testing
+
+/// WordPlus Mesh (1.0.7): rtc-client 1.0.16's diagnostics, as its own tests have them (room/meshStats.test.ts,
+/// meshEncoders.test.ts, meshReceivers.test.ts, meshHealth.test.ts).
+extension WordPlusMeshTests {
+    private func stat(_ id: String, _ type: String, _ values: [String: Any]) -> MeshEncoders.Stat {
+        MeshEncoders.Stat(id: id, type: type, values: values)
+    }
+
+    // A call on 2026-10-23: one sender's camera arrived at 0 kbit/s 11 times in two hours on a clean
+    // line while every viewer froze; the node couldn't tell its camera, its encoder and its sending queue apart
+    @Test func whatALayerSentAndWhatItsCodecDid() {
+        let before = MeshEncoders.Totals(frames: 1000, sent: 1000, packets: 5000, sendDelay: 10, resent: 10, huge: 1,
+                                         limits: ["none": 100, "cpu": 2, "bandwidth": 0, "other": 0], sourceFrames: 1500)
+        // 10 s: the camera gave 140 frames, the encoder made 70 and 60 went, 1.5 s held back by the CPU
+        let now = MeshEncoders.Totals(frames: 1070, sent: 1060, packets: 5500, sendDelay: 12.5, resent: 15, huge: 3,
+                                      limits: ["none": 108.5, "cpu": 3.5, "bandwidth": 0, "other": 0], sourceFrames: 1640)
+        let q = MeshEncoders.sentSince(before, now)
+        #expect(q == .init(encoded: 70, sent: 60, packets: 500, sendDelay: 2.5, resent: 5, huge: 2, limits: ["cpu": 1.5], sourceFrames: 140))
+        // the two layers of one codec: the frames its source gave once, the CPU's hold the longest, the queue averaged
+        var b2 = before
+        b2.packets = 9000
+        b2.sendDelay = 40
+        var n2 = now
+        n2.packets = 10500
+        n2.sendDelay = 41.5
+        n2.limits?["cpu"] = 2.5
+        let h = MeshEncoders.sentSince(b2, n2)
+        let sending = MeshEncoders.sendingOf([q, h])
+        #expect(sending.frames == 140)
+        #expect(sending.limitMs == .init(cpu: 1500))
+        #expect(sending.queueMs == 2)
+        #expect(sending.resent == 0.5)
+        #expect(sending.huge == 4)
+        let none = MeshEncoders.sendingOf([.init()])
+        #expect(none.frames == nil && none.limitMs == nil && none.queueMs == nil && none.resent == nil && none.huge == nil)
+        #expect(MeshEncoders.sentSince(nil, now) == .init(), "nothing from a first reading")
+    }
+
+    /// A layer's frames encoded and sent and its target in the report, read from libwebrtc's stats.
+    @Test func layerSentAndTargetFromStats() throws {
+        func outbound(_ frames: Double, _ sent: Double, _ source: Double) -> [MeshEncoders.Stat] {
+            [stat("OT", "outbound-rtp", ["kind": "video", "rid": "f", "framesEncoded": NSNumber(value: frames), "framesSent": NSNumber(value: sent),
+                                         "framesPerSecond": NSNumber(value: 7), "frameHeight": NSNumber(value: 720),
+                                         "targetBitrate": NSNumber(value: 1_200_000), "packetsSent": NSNumber(value: frames * 5),
+                                         "totalPacketSendDelay": NSNumber(value: frames * 0.01), "codecId": "C", "mediaSourceId": "S",
+                                         "qualityLimitationDurations": ["cpu": NSNumber(value: frames / 100), "none": NSNumber(value: 1)] as NSDictionary]),
+             stat("C", "codec", ["mimeType": "video/VP8"]),
+             stat("S", "media-source", ["frames": NSNumber(value: source), "framesPerSecond": NSNumber(value: 14)])]
+        }
+        let first = MeshEncoders.outbound(of: outbound(1000, 1000, 1500), before: nil)
+        let second = MeshEncoders.outbound(of: outbound(1070, 1060, 1640), before: first.totals)
+        let report = try #require(MeshEncoders.codecReport(second.outbound, named: nil))
+        #expect(report.layers == [.init(rid: "f", fps: 7, height: 720, encoded: 70, sent: 60, target: 1200)])
+        #expect(report.frames == 140)
+        #expect(report.limitMs == .init(cpu: 700))
+        #expect(report.queueMs == 2, "0.7 s of waiting over 350 packets")
+        let json = try #require(MeshEncoders.json([.init(sid: "TR", codecs: [report], stalls: 1, stallMs: 3000)]))
+        let text = String(decoding: json, as: UTF8.self)
