+    @Test @RTC func dynacastLeavesCappedLayersOff() throws {
+        let factory = LKRTCPeerConnectionFactory()
+        let connection = try #require(factory.peerConnection(with: LKRTCConfiguration(), constraints: LKRTCMediaConstraints(mandatoryConstraints: nil, optionalConstraints: nil), delegate: nil))
+        defer { connection.close() }
+        let init_ = LKRTCRtpTransceiverInit()
+        init_.direction = .sendOnly
+        init_.sendEncodings = [layer("q", scale: 4, kbps: 400), layer("h", scale: 2, kbps: 1200), layer("f", scale: 1, kbps: 3500)]
+        let transceiver = try #require(connection.addTransceiver(of: .video, init: init_))
+        let sender = transceiver.sender
+        MeshCappedLayers.set(["f"], for: sender)
+        let qualities: [Livekit_VideoQuality] = [.low, .medium, .high]
+        let all: [Livekit_SubscribedQuality] = qualities.map { q in Livekit_SubscribedQuality.with { $0.quality = q; $0.enabled = true } }
+        sender._set(subscribedQualities: all)
+        #expect(sender.parameters.encodings.map(\.isActive) == [true, true, false])
+        MeshCappedLayers.set([], for: sender)
+        sender._set(subscribedQualities: all)
+        #expect(sender.parameters.encodings.map(\.isActive) == [true, true, true], "caps lifted: dynacast's own say")
+    }
