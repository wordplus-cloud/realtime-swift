+        // a live cap under the trim's own scale stands; one over it gives way to the trim's
+        #expect(MeshSvcTrim.plan(.init(mode: "L3T3_KEY", scale: 3), highest: 1) == .init(mode: "L2T3_KEY", scale: 3, sizes: 2))
+        #expect(MeshSvcTrim.plan(.init(mode: "L3T3_KEY", scale: 1.5), highest: 0) == .init(mode: "L1T3", scale: 4, sizes: 1))
+        #expect(MeshSvcTrim.plan(.init(mode: "L3T3", scale: nil), highest: 0) == .init(mode: "L1T3", scale: 4, sizes: 1))
+        #expect(MeshSvcTrim.plan(.init(mode: "L3T3", scale: nil), highest: 1) == .init(mode: "L3T3", scale: nil, sizes: 3), "L2T3 has no name here: whole")
+    }
+
+    @Test @RTC func dynacastTrimsSvcSizes() throws {
+        // the SDK's own factory, whose encoders take SVC modes (a bare one has no VP9 to check them against)
+        let connection = try #require(RTC.peerConnectionFactory.peerConnection(with: LKRTCConfiguration(), constraints: LKRTCMediaConstraints(mandatoryConstraints: nil, optionalConstraints: nil), delegate: nil))
+        defer { connection.close() }
+        let init_ = LKRTCRtpTransceiverInit()
+        init_.direction = .sendOnly
+        init_.sendEncodings = [RTC.createRtpEncodingParameters(encoding: VideoEncoding(maxBitrate: 1_400_000, maxFps: 30), scalabilityMode: .L3T3_KEY)]
+        let transceiver = try #require(connection.addTransceiver(of: .video, init: init_))
+        let sender = transceiver.sender
+        func asked(_ top: Livekit_VideoQuality?) -> [Livekit_SubscribedQuality] {
+            [Livekit_VideoQuality.low, .medium, .high].map { q in
+                Livekit_SubscribedQuality.with { $0.quality = q; $0.enabled = top.map { q.rawValue <= $0.rawValue } ?? false }
+            }
+        }
+        let first = { sender.parameters.encodings[0] }
+
+        // off: whole, as upstream
+        sender._set(subscribedQualities: asked(.low))
+        #expect(first().scalabilityMode == "L3T3_KEY")
+
+        MeshSvcTrim.set(on: true, for: sender)
+        defer { MeshSvcTrim.set(on: false, for: sender) }
+        sender._set(subscribedQualities: asked(.low))
+        #expect(first().scalabilityMode == "L1T3", "this WebRTC takes the trimmed mode on a sender not yet negotiated")
+        #expect(first().scalabilityMode == "L1T3")
+        #expect(first().scaleResolutionDownBy?.doubleValue == 4)
+        sender._set(subscribedQualities: asked(.medium))
+        #expect(first().scalabilityMode == "L2T3_KEY")
+        #expect(first().scaleResolutionDownBy?.doubleValue == 2)
+        sender._set(subscribedQualities: asked(nil))
+        #expect(!first().isActive)
+        #expect(first().scalabilityMode == "L2T3_KEY", "turned off with its sizes kept")
+        sender._set(subscribedQualities: asked(.high))
+        #expect(first().isActive)
+        #expect(first().scalabilityMode == "L3T3_KEY")
+        #expect(first().scaleResolutionDownBy == nil)
+
+        sender._set(subscribedQualities: asked(.low))
+        MeshSvcTrim.set(on: false, for: sender)
+        sender._set(subscribedQualities: asked(.low))
+        #expect(first().scalabilityMode == "L3T3_KEY", "trim off: whole again")
+        #expect(first().scaleResolutionDownBy == nil)
+    }
+}
