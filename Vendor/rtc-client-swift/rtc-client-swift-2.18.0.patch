+    /// A connection is read once a round however many ask; a reading under way is joined, not repeated.
+    @Test func oneReadingShared() async {
+        let hub = MeshStatsHub()
+        let key = ObjectIdentifier(NSObject())
+        let gathered = StateSync(0)
+        let gather: @Sendable () async -> [MeshEncoders.Stat] = {
+            gathered.mutate { $0 += 1 }
+            return [MeshEncoders.Stat(id: "O", type: "outbound-rtp", values: [:])]
+        }
+        let t0 = Date()
+        async let a = hub.read(key: key, now: t0, gather: gather)
+        async let b = hub.read(key: key, now: t0.addingTimeInterval(0.5), gather: gather)
+        _ = await (a, b)
+        _ = await hub.read(key: key, now: t0.addingTimeInterval(1.8), gather: gather)
+        #expect(gathered.read { $0 } == 1)
+        _ = await hub.read(key: key, now: t0.addingTimeInterval(2), gather: gather)
+        #expect(gathered.read { $0 } == 2)
+        #expect(hub.reads == 2)
+    }
+
+    /// What a minute of a call of 8 asks of a device (the publisher's camera with a backup, 14 tracks received): every
+    /// 10 s the reports' look (both connections), the reports themselves when due (each sender, each receiver, both
+    /// connections' paths), and the hardware-drop watch's camera every 5 s. Read one at a time as until 1.0.6: 108
+    /// gatherings; shared: 18.
+    @Test func readsAMinuteInACallOfEight() async {
+        let hub = MeshStatsHub()
+        // two connections, alive through the test so their identities differ
+        let connections = (NSObject(), NSObject())
+        defer { withExtendedLifetime(connections) {} }
+        let pub = ObjectIdentifier(connections.0)
+        let sub = ObjectIdentifier(connections.1)
+        let gather: @Sendable () async -> [MeshEncoders.Stat] = { [] }
+        var separate = 0
+        let t0 = Date()
+        for second in stride(from: 0, to: 60, by: 5) {
+            let now = t0.addingTimeInterval(Double(second))
+            // the hardware-drop watch's camera
+            _ = await hub.read(key: pub, now: now, gather: gather)
+            separate += 1
+            guard second % 10 == 0 else { continue }
+            // the look, then the reports at a 10 s pace: two senders, 14 receivers, both paths
+            _ = await hub.read(key: pub, now: now, gather: gather)
+            _ = await hub.read(key: sub, now: now, gather: gather)
+            for _ in 0 ..< 2 { _ = await hub.read(key: pub, now: now.addingTimeInterval(0.1), gather: gather) }
+            for _ in 0 ..< 14 { _ = await hub.read(key: sub, now: now.addingTimeInterval(0.2), gather: gather) }
+            separate += 2 + 14
+        }
+        #expect(separate == 12 + 6 * 16)
+        #expect(hub.reads == 12 + 6, "the publisher every 5 s, the subscriber every 10 s")
+    }
