+
+import Foundation
+@testable import LiveKit
+import Testing
+
+/// WordPlus Mesh (1.0.6): a hardware encoder taking a camera's frames off, as @wordplus/realtime-client's own tests have
+/// it (test/encoder-watch.test.ts).
+extension WordPlusMeshTests {
+    // A camera's reading: its 180p in software and its 360p in hardware, at these frames a second of what its source gives.
+    private func layer(_ fps: Double, hardware: Bool, active: Bool = true, limit: String = "none", encodeMs: Double? = nil,
+                       target: Double? = 600_000, sentBps: Double = 700_000) -> HardwareDropRule.Layer
+    {
+        HardwareDropRule.Layer(active: active, fps: fps, hardware: hardware, limit: limit, encodeMs: encodeMs ?? (hardware ? 13 : 1.3),
+                               target: target, sentBps: sentBps)
+    }
+
+    private func camera(_ fps: Double, captured: Double = 15, limit: String = "none", encodeMs: Double? = nil, target: Double? = 600_000,
+                        sentBps: Double = 700_000) -> HardwareDropRule.Reading
+    {
+        HardwareDropRule.Reading(codec: "h264", captured: captured, layers: [
+            layer(fps, hardware: false, limit: limit, target: target, sentBps: sentBps),
+            layer(fps, hardware: true, limit: limit, encodeMs: encodeMs, target: target, sentBps: sentBps),
+        ])
+    }
+
+    private func thirty(_ fps: Double...) -> [HardwareDropRule.Reading] { fps.map { camera($0) } }
+
+    @Test func hardwareDropsFound() {
+        // a Windows PC's AMD encoder, 2026-10-21: 3-6 of 15 every 5 s
+        #expect(HardwareDropRule.dropsFrames(thirty(3, 4, 5, 4, 5, 6)))
+        // the lab's VideoToolbox under heavy grain: every layer at 0.6 for 10-15 s between 20 s at 15
+        #expect(HardwareDropRule.dropsFrames(thirty(15, 15.2, 14.2, 3.6, 0.6, 0.6)))
+        // the AMD PC that sent 17 of 17, a 5 s glitch in 30 s, and under 30 s of readings
+        #expect(!HardwareDropRule.dropsFrames([17, 17, 17, 17, 17, 17].map { camera($0, captured: 17) }))
+        #expect(!HardwareDropRule.dropsFrames(thirty(15, 15, 0.6, 15, 15, 15)))
+        #expect(!HardwareDropRule.dropsFrames(thirty(3, 4, 5, 4, 5)))
+    }
+
+    @Test func hardwareDropsNotOtherCauses() {
+        let fps: [Double] = [3, 4, 5, 4, 5, 6]
+        #expect(!HardwareDropRule.dropsFrames(fps.map { camera($0, limit: "bandwidth") }))
+        #expect(!HardwareDropRule.dropsFrames(fps.map { camera($0, limit: "cpu") }))
+        #expect(!HardwareDropRule.dropsFrames(fps.map { camera($0, encodeMs: 60) }), "a slow device")
+        #expect(!HardwareDropRule.dropsFrames([7, 7, 7, 7, 7, 7].map { camera($0, captured: 7) }), "a dim room")
+        let softwareOnly = HardwareDropRule.Reading(codec: "h264", captured: 15, layers: [
+            layer(4, hardware: false), layer(0, hardware: true, active: false),
+        ])
+        #expect(HardwareDropRule.hardwareReading(softwareOnly) == nil)
+        var vp8 = camera(4)
+        vp8.codec = "vp8"
+        #expect(HardwareDropRule.hardwareReading(vp8) == nil)
+        // software short of bits: its top layer alone short of frames
+        let topShort = HardwareDropRule.Reading(codec: "h264", captured: 15, layers: [
+            layer(14.9, hardware: false), layer(14.9, hardware: true), layer(2.1, hardware: true),
+        ])
+        #expect(!HardwareDropRule.dropsFrames(Array(repeating: topShort, count: 6)))
+        // a frozen camera, every layer on and none sending, kept nothing
+        #expect(HardwareDropRule.hardwareReading(camera(0)).map { [$0.best, $0.captured] } == [0, 15])
+    }
+
+    @Test func hardwareDropsNotAPathGoneDown() {
+        let gone = camera(0, target: nil, sentBps: 0)
+        #expect(HardwareDropRule.hardwareReading(gone) == nil)
+        #expect(HardwareDropRule.hardwareReading(camera(2, sentBps: 100_000)) == nil)
+        #expect(!HardwareDropRule.dropsFrames([camera(15), camera(15), camera(15), gone, camera(2, sentBps: 120_000), camera(15)]))
+        #expect(HardwareDropRule.dropsFrames(thirty(15, 15, 15, 0, 2, 15)), "the same frames, the path up")
+    }
+
+    private func stat(_ id: String, _ type: String, _ values: [String: Any]) -> MeshEncoders.Stat {
+        MeshEncoders.Stat(id: id, type: type, values: values)
+    }
+
+    @Test func hardwareDropsReadFromStats() {
+        let adapter = "SimulcastEncoderAdapter (OpenH264, VideoToolbox)"
+        func report(_ at: Double, frames: [Double], time: [Double]) -> [MeshEncoders.Stat] {
+            var stats = [stat("c", "codec", ["mimeType": "video/H264"]), stat("m", "media-source", ["framesPerSecond": NSNumber(value: 15)])]
+            for (i, rid) in ["q", "h"].enumerated() {
+                stats.append(stat("o" + rid, "outbound-rtp", [
+                    "kind": "video", "rid": rid, "codecId": "c", "mediaSourceId": "m", "active": NSNumber(value: true),
+                    "framesEncoded": NSNumber(value: frames[i]), "totalEncodeTime": NSNumber(value: time[i]),
+                    "qualityLimitationReason": "none", "targetBitrate": NSNumber(value: i == 1 ? 600_000 : 150_000),
+                    "bytesSent": NSNumber(value: at * (i == 1 ? 100 : 20)), "encoderImplementation": adapter,
+                ]))
+            }
+            stats.append(stat("of", "outbound-rtp", ["kind": "video", "rid": "f", "codecId": "c", "mediaSourceId": "m",
+                                                     "active": NSNumber(value: false), "framesEncoded": NSNumber(value: 0)]))
+            return stats
+        }
+        let first = HardwareDropRule.read(report(1000, frames: [100, 100], time: [0.1, 1.3]), at: 1000, before: nil, rids: ["q", "h", "f"])
+        #expect(first.reading == nil)
+        let read = HardwareDropRule.read(report(6000, frames: [120, 120], time: [0.126, 1.566]), at: 6000, before: first.counts,
+                                         rids: ["q", "h", "f"])
+        let layers = read.reading?.layers ?? []
+        #expect(read.reading?.codec == "h264")
+        #expect(read.reading?.captured == 15)
+        #expect(layers.map(\.fps) == [4, 4, 0])
+        #expect(layers.map(\.hardware) == [false, true, false])
+        #expect(layers.map(\.sentBps) == [160_000, 800_000, 0])
+        #expect(layers.map(\.target) == [150_000, 600_000, nil])
+        #expect(abs((layers[1].encodeMs ?? 0) - 13.3) < 0.01)
+        #expect(HardwareDropRule.hardwareReading(read.reading!).map { [$0.best, $0.captured] } == [4, 15])
+    }
+
+    @Test func hardwareDropsCaptureOverTheEncodings() {
+        // a camera giving 60, sent at 30, keeps them all
+        func report(_ at: Double, frames: Double) -> [MeshEncoders.Stat] {
+            [stat("c", "codec", ["mimeType": "video/H264"]), stat("m", "media-source", ["framesPerSecond": NSNumber(value: 60)]),
+             stat("o", "outbound-rtp", ["kind": "video", "codecId": "c", "mediaSourceId": "m", "active": NSNumber(value: true),
+                                         "framesEncoded": NSNumber(value: frames), "totalEncodeTime": NSNumber(value: frames * 0.01),
+                                         "qualityLimitationReason": "none", "targetBitrate": NSNumber(value: 1_500_000),
+                                         "bytesSent": NSNumber(value: at * 190), "encoderImplementation": "VideoToolbox",
+                                         "powerEfficientEncoder": NSNumber(value: true)])]
+        }
+        let first = HardwareDropRule.read(report(1000, frames: 0), at: 1000, before: nil, rids: [""], maxFps: 30)
+        let reading = HardwareDropRule.read(report(6000, frames: 150), at: 6000, before: first.counts, rids: [""], maxFps: 30).reading!
+        #expect(reading.captured == 30)
+        #expect(!HardwareDropRule.dropsFrames(Array(repeating: reading, count: 6)))
+        let uncapped = HardwareDropRule.read(report(6000, frames: 150), at: 6000,
+                                             before: HardwareDropRule.read(report(1000, frames: 0), at: 1000, before: nil, rids: [""]).counts,
+                                             rids: [""]).reading!
+        #expect(HardwareDropRule.dropsFrames(Array(repeating: uncapped, count: 6)), "half of what its source gives")
+    }
+
+    @Test func hardwareDropsSoftwareStandIn() {
+        #expect(MeshEncoders.encoderHardware("OpenH264 (fallback from: VideoToolbox)", powerEfficient: true) == false)
+        #expect(MeshEncoders.encoderHardware("libvpx", powerEfficient: nil) == false)
+        #expect(MeshEncoders.encoderHardware("VideoToolbox", powerEfficient: nil) == true)
+    }
+
+    @Test func hardwareDropsRemembered() {
+        let defaults = UserDefaults(suiteName: "WordPlusMeshHardwareDropsTests")!
+        MeshHardwareDrops.forget(defaults: defaults)
+        let now = Date(timeIntervalSince1970: 1_800_000_000)
+        #expect(MeshHardwareDrops.codecs(now: now, defaults: defaults).isEmpty)
+        MeshHardwareDrops.remember("H264", now: now, defaults: defaults)
+        MeshHardwareDrops.remember("vp8", now: now, defaults: defaults)
+        #expect(MeshHardwareDrops.codecs(now: now, defaults: defaults) == ["h264"], "VP8 never runs in hardware here")
+        #expect(MeshHardwareDrops.codecs(now: now.addingTimeInterval(29 * 24 * 3600), defaults: defaults) == ["h264"])
+        #expect(MeshHardwareDrops.codecs(now: now.addingTimeInterval(31 * 24 * 3600), defaults: defaults).isEmpty, "a month on, tried again")
+        MeshHardwareDrops.forget(defaults: defaults)
+    }
+}
