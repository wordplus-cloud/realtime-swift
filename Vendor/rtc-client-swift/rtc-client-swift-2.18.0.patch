+    /// 1.0.2 (rtc-client 1.0.5): a failed resume moves only off a server that has gone, to one that answers.
+    @Test func resumeMoves() {
+        #expect(Mesh.resumeMoves(ownAnswers: false, nextAnswers: true))
+        #expect(!Mesh.resumeMoves(ownAnswers: true, nextAnswers: true), "its own server is up: the resume failed on the way")
+        #expect(!Mesh.resumeMoves(ownAnswers: false, nextAnswers: false), "nothing answers: this client's network is down")
+    }
