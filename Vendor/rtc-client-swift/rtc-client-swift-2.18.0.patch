+        let second = MeshEncoders.outbound(of: outbound(1070, 1060, 1640), before: first.totals)
+        let report = try #require(MeshEncoders.codecReport(second.outbound, named: nil))
+        #expect(report.layers == [.init(rid: "f", fps: 7, height: 720, encoded: 70, sent: 60, target: 1200)])
