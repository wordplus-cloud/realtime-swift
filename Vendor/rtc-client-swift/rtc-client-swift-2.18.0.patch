+    @Test func nextServer() async throws {
+        let regions = try #require(Mesh.regions(json: Data(meshList.utf8)))
+        let manager = try RegionManager(providedUrl: url("wss://rtc.wordplus.cloud"))
+
+        await manager.setSignalRegions(regions)
+        #expect(await manager.hasSignalRegions())
+        #expect(await !manager.shouldRequestSettings(), "a list the node sends isn't fetched")
+
+        let first = await manager.next(token: "t", skipNode: "ND_a")
+        #expect(first?.node == "ND_b", "the node this client was on is left out")
+
+        await manager.skipNode("ND_c")
+        #expect(await manager.next(token: "t", skipNode: nil) == nil, "busy and tried nodes are left out")
+
+        await manager.resetAttempts()
+        #expect(await manager.next(token: "t", skipNode: nil)?.node == "ND_a", "every node again after a reset")
+
+        #expect(await manager.homeRegion() == "DE1")
+        #expect(await manager.nodeEntry("ND_c")?.url.host == "n-c.bhs.rtc.wordplus.cloud")
+
+        await manager.updateFromServerReportedRegions(.with { $0.regions = [.with { $0.region = "X"; $0.url = "wss://x.rtc.wordplus.cloud" }] })
+        #expect(await manager.nodeEntry("ND_c") != nil, "a leave's list, without nodes, doesn't replace the node's")
+    }
