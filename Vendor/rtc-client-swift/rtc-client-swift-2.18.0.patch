+    private final class StubTransportDelegate: TransportDelegate {
+        func transport(_: Transport, didUpdateState _: LKRTCPeerConnectionState) {}
+        func transport(_: Transport, didGenerateIceCandidate _: IceCandidate) {}
+        func transport(_: Transport, didOpenDataChannel _: LKRTCDataChannel) {}
+        func transport(_: Transport, didAddTrack _: RTCMediaTrack, rtpReceiver _: RTCReceiver, streamIds _: [String]) {}
+        func transport(_: Transport, didRemoveTrackWithId _: String) {}
+        func transportShouldNegotiate(_: Transport) {}
+    }
+
+    /// 1.0.14: someone who joined with no right to publish has media first in their first offer, as it comes before the
+    /// data channels. Taking that track away must not reject its section, which libwebrtc takes as rejecting the whole
+    /// BUNDLE group, the transport and the data channels with it. A later section is released as ever.
+    @Test(.tags(.media)) func theFirstSectionOfTheBundleOutlivesItsTrack() async throws {
+        let delegate = StubTransportDelegate()
+        let publisher = try await Transport(config: .liveKitDefault(), target: .publisher, primary: false, delegate: delegate)
+        let answerer = try await Transport(config: .liveKitDefault(), target: .subscriber, primary: true, delegate: delegate)
+
+        // Exchanges an offer of the publisher for an answer, and answers with what was offered.
+        func negotiate() async throws -> String {
+            let offer = try await publisher.createOffer()
+            try await publisher.set(localDescription: offer)
+            try await answerer.set(remoteDescription: offer)
+            let answer = try await answerer.createAnswer()
+            try await answerer.set(localDescription: answer)
+            try await publisher.set(remoteDescription: answer)
+            return offer.sdp
+        }
+
+        let (microphone, camera) = try await RTC.run {
+            let factory = RTC.peerConnectionFactory
+            let sendOnly = LKRTCRtpTransceiverInit()
+            sendOnly.direction = .sendOnly
+            let audio = factory.audioTrack(with: factory.audioSource(with: nil), trackId: "microphone")
+            let video = factory.videoTrack(with: factory.videoSource(forScreenCast: false), trackId: "camera")
+            let first = try publisher.addTransceiver(with: audio, transceiverInit: sendOnly)
+            let second = try publisher.addTransceiver(with: video, transceiverInit: sendOnly)
+            return (RTCSender(first.sender), RTCSender(second.sender))
+        }
+        _ = await publisher.dataChannel(for: LKRTCDataChannel.Labels.reliable, configuration: RTC.createDataChannelConfiguration())
+
+        let first = try await negotiate()
+        #expect(first.contains("a=group:BUNDLE 0 1 2"), "media comes first, the data channels last")
+
+        try await publisher.remove(track: camera)
+        let withoutCamera = try await negotiate()
+        #expect(withoutCamera.contains("m=video 0 "), "a section further on is released")
+        #expect(withoutCamera.contains("a=group:BUNDLE 0 2"))
+
+        try await publisher.remove(track: microphone)
+        let withoutMicrophone = try await negotiate()
+        #expect(!withoutMicrophone.contains("m=audio 0 "), "the first section is not rejected")
+        #expect(withoutMicrophone.contains("a=group:BUNDLE 0 2"), "the group keeps its first mid")
+        #expect(withoutMicrophone.contains("a=inactive"), "and it carries nothing")
+
+        await publisher.close()
+        await answerer.close()
+    }
+
+    private final class PermissionsHeard: NSObject, RoomDelegate, @unchecked Sendable {
+        private let heard = StateSync([Bool]())
+        var told: [Bool] { heard.read { $0 } }
+        func room(_: Room, participant: Participant, didUpdatePermissions permissions: ParticipantPermissions) {
+            if participant is RemoteParticipant { heard.mutate { $0.append(permissions.canPublish) } }
+        }
+    }
+
+    /// 1.0.14: what someone else may do is told as it changes, not what they join with, and only when it changes.
+    @Test func aRemoteParticipantsPermissionsAreToldAsTheyChange() async throws {
+        let room = Room()
+        let heard = PermissionsHeard()
+        room.delegates.add(delegate: heard)
+
+        func info(canPublish: Bool) -> Livekit_ParticipantInfo {
+            Livekit_ParticipantInfo.with {
+                $0.sid = "PA_someone"
+                $0.identity = "someone"
+                $0.permission = Livekit_ParticipantPermission.with {
+                    $0.canPublish = canPublish
+                    $0.canSubscribe = true
+                }
+            }
+        }
+        func settled() async throws { try await Task.sleep(nanoseconds: 300_000_000) }
+
+        let person = RemoteParticipant(info: info(canPublish: false), room: room, connectionState: .connected)
+        try await settled()
+        #expect(heard.told.isEmpty, "what they join with is no change")
+
+        person.set(info: info(canPublish: true), connectionState: .connected)
+        try await settled()
+        #expect(heard.told == [true])
+        #expect(person.permissions.canPublish)
+
+        person.set(info: info(canPublish: true), connectionState: .connected)
+        try await settled()
+        #expect(heard.told == [true], "nothing changed")
+
+        person.set(info: info(canPublish: false), connectionState: .connected)
+        try await settled()
+        #expect(heard.told == [true, false])
+    }
+}
