+    // A call on 2026-10-23: one viewer's playback froze 3 s on all four cameras at once; how it decodes
+    // and how evenly it shows tell its own machine from the others' senders
+    @Test func howAVideoDecodesAndShowsAndASoundStretches() throws {
+        func totals(_ at: Double, _ values: [String: Double], hw: Bool? = nil) -> MeshReceivers.Totals {
+            var v: [String: Any] = values.mapValues { NSNumber(value: $0) }
+            if let hw { v["powerEfficientDecoder"] = NSNumber(value: hw) }
+            return MeshReceivers.totals(v, at: at)
+        }
+        let before = totals(0, ["packetsReceived": 1000, "packetsLost": 0, "framesDecoded": 100, "totalDecodeTime": 1,
+                                "totalInterFrameDelay": 3.3, "totalSquaredInterFrameDelay": 0.11, "pauseCount": 0,
+                                "totalPausesDuration": 0, "pliCount": 1, "nackCount": 10, "jitter": 0.004])
+        // 10 s, 150 frames: 6 ms each to decode; 140 gaps of 66 ms and 10 of 200 ms (sum 11.24 s, squares 1.0098)
+        let after = totals(10000, ["packetsReceived": 2000, "packetsLost": 0, "framesDecoded": 250, "totalDecodeTime": 1.9,
+                                   "totalInterFrameDelay": 3.3 + 11.24, "totalSquaredInterFrameDelay": 0.11 + 1.0098,
+                                   "pauseCount": 1, "totalPausesDuration": 5.5, "pliCount": 3, "nackCount": 10, "jitter": 0.012], hw: true)
+        let read = try #require(MeshReceivers.reading(sid: "TR_v", video: true, prev: before, now: after))
+        #expect(read.decodeMs == 6 && read.hwDec == true && read.pauses == 1 && read.pauseMs == 5500 && read.plis == 2 && read.jitterMs == 12)
+        #expect(read.nacks == nil)
+        #expect((31 ..< 40).contains(read.unevenMs ?? 0))
+
+        let a0 = totals(0, ["packetsReceived": 500, "packetsLost": 0, "totalSamplesReceived": 480_000,
+                            "insertedSamplesForDeceleration": 1000, "removedSamplesForAcceleration": 0])
+        let a1 = totals(10000, ["packetsReceived": 1000, "packetsLost": 0, "totalSamplesReceived": 960_000,
+                                "insertedSamplesForDeceleration": 5800, "removedSamplesForAcceleration": 4800])
+        #expect(MeshReceivers.reading(sid: "TR_a", video: false, prev: a0, now: a1)?.stretched == 2)
+    }
