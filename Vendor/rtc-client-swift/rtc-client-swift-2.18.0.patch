+    @Test func capsOverTheLadder() {
+        // a 1080-line camera's ladder: 270, 540, 1080
+        var ladder = [layer("q", scale: 4, kbps: 400), layer("h", scale: 2, kbps: 1200), layer("f", scale: 1, kbps: 3500)]
+        var off = MeshCaps(height: 720).apply(to: ladder, lines: 1080)
+        #expect(off.isEmpty)
+        #expect(ladder[2].scaleResolutionDownBy?.doubleValue == 1.5, "the top layer scaled down to 720")
+        #expect(abs((ladder[2].maxBitrateBps?.doubleValue ?? 0) - 3_500_000 * pow(720.0 / 1080, 1.5)) < 2, "and its bitrate with it")
+        #expect(ladder[1].scaleResolutionDownBy?.doubleValue == 2, "540 untouched")
+
+        ladder = [layer("q", scale: 4, kbps: 400), layer("h", scale: 2, kbps: 1200), layer("f", scale: 1, kbps: 3500)]
+        off = MeshCaps(height: 540).apply(to: ladder, lines: 1080)
+        #expect(off == ["f"], "a lower layer covers the cap: the top goes off")
+        #expect(!ladder[2].isActive)
+
+        ladder = [layer("q", scale: 4, kbps: 400), layer("h", scale: 2, kbps: 1200), layer("f", scale: 1, kbps: 3500)]
+        off = MeshCaps(fps: 15, kbps: 1000).apply(to: ladder, lines: 1080)
+        #expect(off.isEmpty)
+        #expect(ladder.allSatisfy { $0.maxFramerate?.intValue == 15 })
+        #expect(ladder.map { $0.maxBitrateBps?.intValue } == [400_000, 1_000_000, 1_000_000])
+
+        let svc = [RTC.createRtpEncodingParameters(encoding: VideoEncoding(maxBitrate: 2_800_000, maxFps: 30), scalabilityMode: .L3T3_KEY)]
+        #expect(MeshCaps(height: 360).apply(to: svc, lines: 1080).isEmpty, "one SVC stream is scaled whole, never turned off")
+        #expect(svc[0].scaleResolutionDownBy?.doubleValue == 3)
+        #expect(MeshCaps().apply(to: ladder, lines: 1080).isEmpty)
+
+        // the server's and the product's own: the stricter of each
+        #expect(MeshCaps(height: 720, fps: 0, kbps: 2000).combined(with: MeshCaps(height: 540, fps: 24)) == MeshCaps(height: 540, fps: 24, kbps: 2000))
+        #expect(MeshCaps().combined(with: MeshCaps()) == MeshCaps())
