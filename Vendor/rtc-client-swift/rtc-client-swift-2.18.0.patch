+    private func layer(_ rid: String, scale: Double, kbps: Int, fps: Int = 30) -> LKRTCRtpEncodingParameters {
+        RTC.createRtpEncodingParameters(rid: rid, encoding: VideoEncoding(maxBitrate: kbps * 1000, maxFps: fps), scaleDownBy: scale)
