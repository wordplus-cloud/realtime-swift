+
+        #expect(sections[0].hasRtcpFeedback("nack", forPayload: "111"), "the microphone's Opus, under its RED")
+        #expect(!sections[0].hasRtcpFeedback("nack", forPayload: "63"))
+        #expect(!sections[1].hasRtcpFeedback("nack", forPayload: "111"), "another sender's sound is left as it was")
+        #expect(!sections[2].hasRtcpFeedback("nack", forPayload: "96"), "no video")
+        #expect(!sections[3].hasRtcpFeedback("nack", forPayload: "111"), "nor a section it doesn't send on")
+        #expect(listed.hasSuffix("\r\n"))
+        #expect(Transport.listAudioNack(listed, senderIds: ["mic"]) == listed, "listed once")
+
+        #expect(AudioPublishOptions().resend == false, "off unless a publish asks")
+        #expect(AudioPublishOptions(resend: true) != AudioPublishOptions())
+    }
