+        let sub = ObjectIdentifier(connections.1)
+        let gather: @Sendable () async -> [MeshEncoders.Stat] = { [] }
+        var separate = 0
+        let t0 = Date()
+        for second in stride(from: 0, to: 60, by: 5) {
+            let now = t0.addingTimeInterval(Double(second))
+            // the hardware-drop watch's camera
+            _ = await hub.read(key: pub, now: now, gather: gather)
+            separate += 1
+            guard second % 10 == 0 else { continue }
+            // the look, then the reports at a 10 s pace: two senders, 14 receivers, both paths
+            _ = await hub.read(key: pub, now: now, gather: gather)
+            _ = await hub.read(key: sub, now: now, gather: gather)
+            for _ in 0 ..< 2 { _ = await hub.read(key: pub, now: now.addingTimeInterval(0.1), gather: gather) }
+            for _ in 0 ..< 14 { _ = await hub.read(key: sub, now: now.addingTimeInterval(0.2), gather: gather) }
+            separate += 2 + 14
+        }
+        #expect(separate == 12 + 6 * 16)
+        #expect(hub.reads == 12 + 6, "the publisher every 5 s, the subscriber every 10 s")
+    }
+
+    @Test func theDeviceAndTheApp() {
+        let watch = MeshHealthWatch()
+        let t0 = Date()
+        watch.pressureChanged("nominal", now: t0)
+        #expect(!watch.troubled())
+        watch.pressureChanged("serious", now: t0.addingTimeInterval(2))
+        #expect(watch.troubled())
+        watch.pressureChanged("fair", now: t0.addingTimeInterval(5))
+        watch.visibilityChanged(hidden: true, now: t0.addingTimeInterval(6))
+        watch.visibilityChanged(hidden: false, now: t0.addingTimeInterval(7.5))
+        watch.deviceChanged()
+        watch.batteryChanged(onBattery: true)
+        var report = watch.reading(paths: [:], now: t0.addingTimeInterval(10))
+        #expect(report.cpu == "serious" && report.cpuMs == 3000 && report.hiddenMs == 1500 && report.devices == 1 && report.battery == true)
+        #expect(report.machine != nil, "the device once")
+        #expect(report.hangs == nil, "no hangs counted natively")
+        // the next reading starts from the state it is in now, and says the device no more
+        report = watch.reading(paths: [:], now: t0.addingTimeInterval(20))
+        #expect(report.cpu == "fair" && report.cpuMs == nil && report.hiddenMs == nil && report.devices == nil && report.machine == nil)
+        #expect(!watch.troubled())
+        watch.tellMachineAgain()
+        #expect(watch.reading(paths: [:], now: t0.addingTimeInterval(30)).machine != nil)
+        // in the background across a reading: counted to it, and on from it
+        watch.visibilityChanged(hidden: true, now: t0.addingTimeInterval(35))
+        #expect(watch.reading(paths: [:], now: t0.addingTimeInterval(40)).hiddenMs == 5000)
+        #expect(watch.reading(paths: [:], now: t0.addingTimeInterval(50)).hiddenMs == 10000)
+        #expect(MeshHealth.pressure(.critical) == "critical")
+    }
+
+    @Test func aConnectionsPath() throws {
+        func reading(_ discarded: Double, _ asked: Double, _ answered: Double, _ changes: Double) -> [MeshEncoders.Stat] {
+            [stat("T", "transport", ["selectedCandidatePairId": "P", "selectedCandidatePairChanges": NSNumber(value: changes)]),
+             stat("P", "candidate-pair", ["currentRoundTripTime": NSNumber(value: 0.083), "availableOutgoingBitrate": NSNumber(value: 1_234_000),
+                                          "packetsDiscardedOnSend": NSNumber(value: discarded), "consentRequestsSent": NSNumber(value: asked),
+                                          "responsesReceived": NSNumber(value: answered)])]
+        }
+        let first = try #require(MeshHealth.path(reading(0, 10, 10, 1), before: nil))
+        #expect(first.path == .init(rtt: 83, outKbps: 1234))
+        // Wi-Fi dropping out: packets the system couldn't send, checks unanswered, a new path
+        let second = try #require(MeshHealth.path(reading(40, 16, 12, 2), before: first.totals))
+        #expect(second.path == .init(rtt: 83, outKbps: 1234, sendFailed: 40, unanswered: 4, switched: 1))
+        #expect(MeshHealth.path([stat("T", "transport", [:])], before: nil) == nil)
+
+        let watch = MeshHealthWatch()
+        _ = watch.reading(paths: ["pub": reading(0, 10, 10, 1)])
+        #expect(watch.reading(paths: ["pub": reading(40, 16, 12, 2), "sub": reading(0, 1, 1, 1)]).pub?.sendFailed == 40)
+    }
+
+    /// The node's pace in a response of its own; the reading's reports in one request, each in its field.
+    @Test func paceAndOneRequest() throws {
+        let pace = Mesh.lengthDelimited(Mesh.reportsField, Data(#"{"every":30000}"#.utf8))
+        #expect(Mesh.reportPace(inSignalMessage: pace) == 30000)
+        #expect(Mesh.reportPace(inSignalMessage: Mesh.lengthDelimited(Mesh.reportsField, Data(#"{"every":0}"#.utf8))) == 0)
+        #expect(Mesh.reportPace(inSignalMessage: Mesh.lengthDelimited(Mesh.regionsField, Data(#"{"regions":[]}"#.utf8))) == nil)
+        #expect(Mesh.reportPace(inSignalMessage: Mesh.lengthDelimited(Mesh.reportsField, Data(#"{"every":-1}"#.utf8))) == nil)
+
+        let encoders = Data(#"{"tracks":[]}"#.utf8)
+        let receivers = Data(#"{"tracks":[{"kind":"video","sid":"TR"}]}"#.utf8)
+        let health = try #require(MeshHealth.json(.init(cpu: "serious", cpuMs: 1200)))
+        #expect(String(decoding: health, as: UTF8.self) == #"{"cpu":"serious","cpuMs":1200}"#)
+        let bytes = Mesh.lengthDelimited(MeshEncoders.field, encoders) + Mesh.lengthDelimited(MeshReceivers.field, receivers) +
+            Mesh.lengthDelimited(MeshHealth.field, health)
+        let request = try Livekit_SignalRequest(serializedBytes: bytes)
+        #expect(request.message == nil, "no message of LiveKit's")
+        #expect(Mesh.lengthDelimitedField(MeshEncoders.field, in: bytes) == encoders)
+        #expect(Mesh.lengthDelimitedField(MeshReceivers.field, in: bytes) == receivers)
+        #expect(Mesh.lengthDelimitedField(MeshHealth.field, in: bytes) == health)
+    }
+}
