+// Generated from WordPlus Mesh's pkg/clientsettings/schema.json (version 1) by clients/settings-schema.mjs:
+// don't edit, regenerate.
+
+extension MeshSettingsSchema {
+    static let version = 1
+
+    static let keys: [String: MeshSettingKey] = [
+        "camera.codecs": MeshSettingKey(type: .codecs, keyClass: .publish, min: nil, max: nil, values: nil, maxLength: 0, defaultJSON: #"["h264:hw","vp8"]"#),
+        "camera.codecRules": MeshSettingKey(type: .codecRules, keyClass: .publish, min: nil, max: nil, values: nil, maxLength: 0, defaultJSON: #"null"#),
+        "camera.backup": MeshSettingKey(type: .enumeration, keyClass: .publish, min: nil, max: nil, values: ["vp8", "h264"], maxLength: 0, defaultJSON: #""vp8""#),
+        "screen.codecs": MeshSettingKey(type: .codecs, keyClass: .publish, min: nil, max: nil, values: nil, maxLength: 0, defaultJSON: #"null"#),
+        "check.enabled": MeshSettingKey(type: .bool, keyClass: .publish, min: nil, max: nil, values: nil, maxLength: 0, defaultJSON: #"true"#),
+        "adapt.enabled": MeshSettingKey(type: .bool, keyClass: .live, min: nil, max: nil, values: nil, maxLength: 0, defaultJSON: #"true"#),
+        "tune.checkMs": MeshSettingKey(type: .int, keyClass: .publish, min: 2000.0, max: 5000.0, values: nil, maxLength: 0, defaultJSON: #"4000"#),
+        "tune.passSent": MeshSettingKey(type: .number, keyClass: .publish, min: 0.3, max: 1.0, values: nil, maxLength: 0, defaultJSON: #"0.8"#),
+        "tune.passCpu": MeshSettingKey(type: .number, keyClass: .publish, min: 0.0, max: 1.0, values: nil, maxLength: 0, defaultJSON: #"0.5"#),
+        "tune.passEncode": MeshSettingKey(type: .number, keyClass: .publish, min: 0.1, max: 1.0, values: nil, maxLength: 0, defaultJSON: #"0.6"#),
+        "tune.dropWatchS": MeshSettingKey(type: .int, keyClass: .live, min: 10.0, max: 120.0, values: nil, maxLength: 0, defaultJSON: #"30"#),
+        "tune.cpuWatchS": MeshSettingKey(type: .int, keyClass: .live, min: 10.0, max: 120.0, values: nil, maxLength: 0, defaultJSON: #"20"#),
+        "tune.cpuShare": MeshSettingKey(type: .number, keyClass: .live, min: 0.1, max: 1.0, values: nil, maxLength: 0, defaultJSON: #"0.5"#),
+        "tune.switchesMax": MeshSettingKey(type: .int, keyClass: .live, min: 0.0, max: 3.0, values: nil, maxLength: 0, defaultJSON: #"2"#),
+        "tune.switchGapS": MeshSettingKey(type: .int, keyClass: .live, min: 30.0, max: 1800.0, values: nil, maxLength: 0, defaultJSON: #"120"#),
