+    /// A sender's part of the connection's reading: its outbound streams by mid with everything they refer to, or by its
+    /// track's media source where no mid is named; a receiver's by its track.
+    @Test func partsOfASharedReading() throws {
+        let full = [
+            stat("O1", "outbound-rtp", ["mid": "0", "codecId": "C1", "mediaSourceId": "S1", "transportId": "T", "remoteId": "R1"]),
+            stat("O2", "outbound-rtp", ["mid": "1", "codecId": "C2", "mediaSourceId": "S2"]),
+            stat("C1", "codec", ["mimeType": "video/H264"]),
+            stat("C2", "codec", ["mimeType": "video/VP8"]),
+            stat("S1", "media-source", ["trackIdentifier": "cam"]),
+            stat("S2", "media-source", ["trackIdentifier": "cam"]),
+            stat("R1", "remote-inbound-rtp", [:]),
+            stat("T", "transport", ["selectedCandidatePairId": "P"]),
+            stat("P", "candidate-pair", ["localCandidateId": "L", "remoteCandidateId": "RC"]),
+            stat("L", "local-candidate", [:]),
+            stat("RC", "remote-candidate", [:]),
+            stat("I1", "inbound-rtp", ["trackIdentifier": "remote-a", "codecId": "C2"]),
+        ]
+        let part = try #require(MeshStats.forSender(full, mid: "0", trackId: "cam", sendersOfTrack: 2))
+        #expect(Set(part.map(\.id)) == ["O1", "C1", "S1", "T", "P", "L", "RC", "R1"])
+        // the backup's sender on mid 1 sends the same track: told apart by its mid alone
+        #expect(Set(try #require(MeshStats.forSender(full, mid: "1", trackId: "cam", sendersOfTrack: 2)).map(\.id)) == ["O2", "C2", "S2"])
+        #expect(MeshStats.forSender(full, mid: nil, trackId: "cam", sendersOfTrack: 2) == nil, "no mid yet")
+
+        // a reading that names no mid: by the track's media source, only where one sender sends it
+        let noMid = [stat("O", "outbound-rtp", ["mediaSourceId": "S"]), stat("S", "media-source", ["trackIdentifier": "cam"])]
+        #expect(MeshStats.forSender(noMid, mid: nil, trackId: "cam", sendersOfTrack: 1)?.map(\.id) == ["O", "S"])
+        #expect(MeshStats.forSender(noMid, mid: nil, trackId: "cam", sendersOfTrack: 2) == nil)
+
+        #expect(Set(try #require(MeshStats.forReceiver(full, trackId: "remote-a")).map(\.id)) == ["I1", "C2"])
+        #expect(MeshStats.forReceiver(full, trackId: "gone") == nil)
+    }
