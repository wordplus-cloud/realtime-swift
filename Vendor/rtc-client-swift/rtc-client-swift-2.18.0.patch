+ * limitations under the License.
+ */
+
+import Foundation
+@testable import LiveKit
+import Testing
+
+/// WordPlus Mesh: what this client does differently on a mesh's servers, as @wordplus/rtc-client's own tests have it.
+@Suite struct WordPlusMeshTests {
+    private func url(_ string: String) throws -> URL {
+        try #require(URL(string: string))
+    }
+
+    private let meshList = """
+    {"regions":[
+      {"region":"DE1","url":"wss://n-a.de.rtc.wordplus.cloud","distance":"0","node":"ND_a"},
+      {"region":"DE1","url":"wss://n-b.de.rtc.wordplus.cloud","distance":"0","node":"ND_b"},
+      {"region":"BHS","url":"wss://n-c.bhs.rtc.wordplus.cloud","distance":"5900000","node":"ND_c"}
+    ]}
+    """
+
+    @Test func meshDomains() throws {
+        #expect(try url("wss://rtc.wordplus.cloud").isMeshServer)
+        #expect(try url("wss://n-abc123.de.rtc.wordplus.cloud").isMeshServer)
+        #expect(try url("wss://rtc.wordplus.cloud").isCloud, "a mesh's servers fail over as LiveKit Cloud's do")
+        #expect(try !url("wss://notrtc.wordplus.cloud").isMeshServer)
+        #expect(try !url("wss://video-cloud.better-messages.com").isMeshServer)
+        #expect(try !url("wss://video-cloud.better-messages.com").isCloud)
+
+        #expect(try !url("ws://mesh.test.example").isMeshServer)
+        MeshDomains.add("test.example")
+        #expect(try url("ws://mesh.test.example").isMeshServer, "a product adds its own mesh's domain")
+    }
+
+    @Test func meshWaitFlag() throws {
+        let waiting = try url("wss://n-a.de.rtc.wordplus.cloud").withMeshWait()
+        #expect(waiting.isMeshWait)
+        #expect(waiting.withMeshWait().absoluteString == waiting.absoluteString, "said once")
+        #expect(try !url("wss://n-a.de.rtc.wordplus.cloud").isMeshWait)
+    }
+
+    @Test func joinParameters() throws {
+        let options = ConnectOptions(meshJoinBudget: 30, meshHardwareDecoders: ["h264", "h265"], onMeshWait: nil)
+
+        let mesh = try Utils.buildUrl(url("wss://n-a.de.rtc.wordplus.cloud").withMeshWait(), connectOptions: options, adaptiveStream: false)
+        let items = try #require(URLComponents(url: mesh, resolvingAgainstBaseURL: false)?.queryItems)
+
+        #expect(items.contains(URLQueryItem(name: "mesh_client", value: "1")), "a mesh is told this client walks and waits")
+        #expect(items.contains(URLQueryItem(name: "mesh_hwdec", value: "h264,h265")))
+        #expect(items.contains(URLQueryItem(name: "mesh_wait", value: "1")), "the wait the walk chose is carried")
+        #expect(items.contains { $0.name == "sdk" }, "upstream's own are kept")
+
+        let stock = try Utils.buildUrl(url("wss://video-cloud.better-messages.com"), connectOptions: options, adaptiveStream: false)
+        #expect(!(URLComponents(url: stock, resolvingAgainstBaseURL: false)?.queryItems ?? []).contains { $0.name.hasPrefix("mesh_") },
+                "any other server is asked nothing")
+    }
+
+    /// 1.0.3 (rtc-client 1.0.6 to 1.0.8): the client's own version, what it can do, the room's product, the device and
+    /// the codecs it encodes in hardware, to a mesh only.
+    @Test func joinNamesTheClient() throws {
+        let options = ConnectOptions(meshJoinBudget: 30, meshHardwareDecoders: [], onMeshWait: nil,
+                                     meshHardwareEncoders: ["h264"], meshApp: MeshApp(name: "better-messages", version: "3.1.4"))
+
+        let mesh = try Utils.buildUrl(url("wss://n-a.de.rtc.wordplus.cloud"), connectOptions: options, adaptiveStream: false)
+        let items = try #require(URLComponents(url: mesh, resolvingAgainstBaseURL: false)?.queryItems)
+        #expect(items.contains(URLQueryItem(name: "rtc_client", value: Mesh.clientVersion)))
+        #expect(items.contains(URLQueryItem(name: "mesh_caps", value: "audio-pause,codec-policy")))
+        #expect(items.contains(URLQueryItem(name: "rtc_app", value: "better-messages/3.1.4")))
+        #expect(items.contains(URLQueryItem(name: "mesh_hwenc", value: "h264")))
+        #expect(items.contains(URLQueryItem(name: "device_type", value: "desktop")), "these tests run on a Mac")
+        #expect(!items.contains { $0.name == "mesh_hwdec" }, "nothing said when the app knows none")
+
+        let stock = try Utils.buildUrl(url("wss://video-cloud.better-messages.com"), connectOptions: options, adaptiveStream: false)
+        let stockItems = URLComponents(url: stock, resolvingAgainstBaseURL: false)?.queryItems ?? []
+        #expect(!stockItems.contains { ["rtc_client", "rtc_app", "device_type", "mesh_caps", "mesh_hwenc"].contains($0.name) })
+
+        #expect(Mesh.appParam(nil) == nil)
+        #expect(Mesh.appParam(MeshApp(name: "Easy Stream<script>", version: "1.0 beta")) == "EasyStreamscript/1.0beta")
+        #expect(Mesh.appParam(MeshApp(name: "wordplus-sdk")) == "wordplus-sdk/")
+
+        #expect(Mesh.deviceType(model: "iPhone17,1", simulatorModel: nil) == "phone")
+        #expect(Mesh.deviceType(model: "iPad16,3", simulatorModel: nil) == "tablet")
+        #expect(Mesh.deviceType(model: "iOSSimulator,arm64", simulatorModel: "iPhone17,3") == "phone")
+        #expect(Mesh.deviceType(model: "AppleTV14,1", simulatorModel: nil) == nil)
+    }
+
+    /// 1.0.3 (rtc-client 1.0.8): the codec policy a node sends in its join response's field 1001, names only.
+    @Test func codecPolicy() throws {
+        let join = Livekit_JoinResponse.with { $0.serverInfo = .with { $0.nodeID = "ND_a" } }
+        let json = #"{"camera":["h264:hw","vp8"],"screen":["vp9",7,"a-codec-name-far-too-long"],"backup":"vp8","note":"x"}"#
+        let bytes = try join.serializedData() + Mesh.lengthDelimited(Mesh.codecPolicyField, Data(json.utf8))
+        let decoded = try Livekit_JoinResponse(serializedBytes: bytes)
+
+        let policy = try #require(Mesh.codecPolicy(inJoinResponse: bytes))
+        #expect(policy.camera == ["h264:hw", "vp8"])
+        #expect(policy.screen == ["vp9"], "only names, 16 characters at most")
+        #expect(policy.backup == "vp8")
+        #expect(decoded.serverInfo.nodeID == "ND_a", "LiveKit's own fields read as before")
+
+        // 1.0.7: read from the signal message's bytes (its join, field 1), which the room is handed beside the
+        // decoded response; nanopb keeps no unknown fields
+        let message = Mesh.lengthDelimited(1, bytes)
+        let response = try Livekit_SignalResponse(serializedBytes: message)
+        guard case let .join(fromMessage) = response.message else {
+            Issue.record("the message is a join response")
+            return
+        }
+        #expect(fromMessage.serverInfo.nodeID == "ND_a")
+        #expect(Mesh.codecPolicy(inSignalMessage: message) == policy)
+
+        #expect(Mesh.codecPolicy(inJoinResponse: Data()) == nil, "a node that sends none")
+        #expect(Mesh.codecPolicy(inJoinResponse: Mesh.lengthDelimited(Mesh.codecPolicyField, Data("not json".utf8))) == nil)
+        #expect(Mesh.codecPolicy(inSignalMessage: try Livekit_SignalResponse.with { $0.join = join }.serializedData()) == nil)
+    }
+
+    /// 1.0.7 (rtc-client 1.0.16, WordPlus Mesh 1.0.53): the node's check and adapt switches and its numbers by name, as
+    /// the browser's client reads them: booleans only, and numbers only, 32 at most, names of 24 characters at most.
+    @Test func codecPolicySwitchesAndTune() throws {
+        func policy(_ json: String) throws -> MeshCodecPolicy {
+            try #require(Mesh.codecPolicy(inJoinResponse: Mesh.lengthDelimited(Mesh.codecPolicyField, Data(json.utf8))))
+        }
+
+        let tune = #"{"failsafeS":4.5,"checkMs":3000,"flag":true,"text":"10","list":[1],"none":null,"aNameOfMoreThanTwentyFourLetters":5}"#
+        let given = try policy(#"{"camera":["vp9"],"check":true,"adapt":false,"tune":"# + tune + "}")
+        #expect(given.camera == ["vp9"])
+        #expect(given.check == true)
+        #expect(given.adapt == false)
+        #expect(given.tune == ["failsafeS": 4.5, "checkMs": 3000], "numbers only: no boolean, string, list, null or long name")
+
+        // switches that are no JSON boolean, and a tune that is no object: none of either
+        let odd = try policy(#"{"check":1,"adapt":"true","tune":[1,2]}"#)
+        #expect(odd.check == nil)
+        #expect(odd.adapt == nil)
+        #expect(odd.tune == nil)
+
+        // a node before 1.0.53 says neither
+        let older = try policy(#"{"camera":["vp8"],"backup":"vp8"}"#)
+        #expect(older == MeshCodecPolicy(camera: ["vp8"], backup: "vp8"))
+        let empty = try policy(#"{"tune":{}}"#)
+        #expect(empty.tune == [:], "an empty tune is a tune")
+
+        // at most 32 keys, the first by name, as the node sends them sorted
+        let many = (0 ..< 40).map { "\"k\($0 < 10 ? "0" : "")\($0)\":\($0)" }.joined(separator: ",")
+        let crowded = try policy("{\"tune\":{" + many + "}}")
+        let capped = try #require(crowded.tune)
+        #expect(capped.count == 32)
+        #expect(capped["k31"] == 31)
+        #expect(capped["k32"] == nil)
+    }
+
+    @Test func regionListWithNodes() throws {
+        let regions = try #require(Mesh.regions(json: Data(meshList.utf8)))
+
+        #expect(regions.count == 3)
+        #expect(regions[0].node == "ND_a")
+        #expect(regions[2].distance == 5_900_000)
+        #expect(regions[0] != regions[1], "two nodes of one region are two entries")
+    }
+
+    @Test func regionListOverTheSignalConnection() throws {
+        let json = Data(meshList.utf8)
+        var message = Data([0xA2, 0x06]) // field 100, length-delimited
+        var length = json.count
+        while length >= 0x80 {
+            message.append(UInt8(length & 0x7F) | 0x80)
+            length >>= 7
+        }
+        message.append(UInt8(length))
+        message.append(json)
+
+        let regions = try #require(Mesh.regions(inSignalMessage: message))
+        #expect(regions.map(\.node) == ["ND_a", "ND_b", "ND_c"])
+
+        let pong = try Livekit_SignalResponse.with { $0.pongResp = .with { $0.lastPingTimestamp = 42 } }.serializedData()
+        #expect(Mesh.regions(inSignalMessage: pong) == nil, "any other response is upstream's to read")
+    }
