+
+
+import Foundation
+@testable import LiveKit
+import Testing
+
+/// WordPlus RTC client: a key held at an index without sending under it, then used (the mesh's clients/swift README).
+@Suite struct WordPlusMeshKeysTests {
+    @Test func aHeldKeyDecryptsItsIndexAndMovesNothing() throws {
+        let provider = BaseKeyProvider(isSharedKey: true)
+        provider.setKey(keyData: Data("epoch-0".utf8), index: 0)
+        provider.holdKey(keyData: Data("epoch-1".utf8), index: 1)
+
+        #expect(try #require(provider.exportKey(index: 1)) == Data("epoch-1".utf8))
+        #expect(try #require(provider.exportKey(index: 0)) == Data("epoch-0".utf8))
+        // setKey would have moved the data packets' index to 1.
+        #expect(provider.getCurrentKeyIndex() == 0)
+    }
+
+    @Test func aHeldKeyTakesItsIndexModuloTheRing() throws {
+        let provider = BaseKeyProvider(isSharedKey: true)
+        provider.holdKey(keyData: Data("epoch-17".utf8), index: 17)
+        #expect(try #require(provider.exportKey(index: 1)) == Data("epoch-17".utf8))
+    }
+
+    @Test func useKeyMovesTheSenderAndTheDataPacketsModuloTheRing() async {
+        let provider = BaseKeyProvider(isSharedKey: true)
+        let manager = E2EEManager(options: EncryptionOptions(keyProvider: provider))
+        #expect(manager.senderKeyIndex == nil)
+
+        provider.holdKey(keyData: Data("epoch-1".utf8), index: 1)
+        await manager.useKey(index: 1)
+        #expect(manager.senderKeyIndex == 1)
+        #expect(provider.getCurrentKeyIndex() == 1)
+
+        await manager.useKey(index: 18)
+        #expect(manager.senderKeyIndex == 2)
+        #expect(provider.getCurrentKeyIndex() == 2)
+    }
+}
