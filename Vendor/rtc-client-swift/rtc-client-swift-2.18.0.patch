+
+import Foundation
+@testable import LiveKit
+import Testing
+
+/// WordPlus Mesh (1.0.6): the receive reports, as @wordplus/rtc-client's own tests have them (room/meshReceivers.test.ts).
+extension WordPlusMeshTests {
+    private func totals(_ at: Double, _ values: [String: Double]) -> MeshReceivers.Totals {
+        MeshReceivers.totals(values.mapValues { NSNumber(value: $0) }, at: at)
+    }
+
+    @Test func receivedVideoAsItPlays() throws {
+        let before = totals(10000, ["packetsReceived": 1000, "packetsLost": 10, "framesDecoded": 300, "freezeCount": 1,
+                                    "totalFreezesDuration": 0.4, "framesDropped": 2, "jitterBufferDelay": 30,
+                                    "jitterBufferEmittedCount": 300])
+        let values: [String: Any] = ["packetsReceived": NSNumber(value: 1990), "packetsLost": NSNumber(value: 20),
+                                     "framesDecoded": NSNumber(value: 450), "freezeCount": NSNumber(value: 3),
+                                     "totalFreezesDuration": NSNumber(value: 1.6), "framesDropped": NSNumber(value: 5),
+                                     "jitterBufferDelay": NSNumber(value: 45), "jitterBufferEmittedCount": NSNumber(value: 450),
+                                     "frameHeight": NSNumber(value: 720)]
+        let read = MeshReceivers.reading(sid: "TR_v", video: true, prev: before, now: MeshReceivers.totals(values, at: 20000),
+                                         height: MeshReceivers.height(values))
+        #expect(read == .init(sid: "TR_v", kind: "video", fps: 15, height: 720, freezes: 2, freezeMs: 1200, dropped: 3, lost: 1, jbMs: 100))
+    }
+
+    /// concealment while someone spoke, not while they were silent; audio's jitter buffer delay adds up per sample
+    @Test func receivedAudioAsHeard() {
+        let before = totals(0, ["packetsReceived": 500, "packetsLost": 0, "totalSamplesReceived": 480_000, "concealedSamples": 4800,
+                                "silentConcealedSamples": 4000, "jitterBufferDelay": 28800, "jitterBufferEmittedCount": 480_000])
+        // of the 28,800 more made up, 4,800 while silent: 24,000 heard, 5 % of 480,000
+        let now = totals(10000, ["packetsReceived": 1000, "packetsLost": 0, "totalSamplesReceived": 960_000, "concealedSamples": 33600,
+                                 "silentConcealedSamples": 8800, "jitterBufferDelay": 57600, "jitterBufferEmittedCount": 960_000])
+        #expect(MeshReceivers.reading(sid: "TR_a", video: false, prev: before, now: now) ==
+            .init(sid: "TR_a", kind: "audio", concealed: 5, lost: 0, jbMs: 60))
+    }
+
+    @Test func nothingFromAFirstReadingOrAReceiverThatStartedOver() {
+        let now = totals(5000, ["packetsReceived": 100, "packetsLost": 0])
+        #expect(MeshReceivers.reading(sid: "TR", video: true, prev: nil, now: now) == nil)
+        #expect(MeshReceivers.reading(sid: "TR", video: true, prev: now, now: totals(15000, ["packetsReceived": 50])) == nil)
+        // a device that keeps no freezes says none
+        let first = totals(5000, ["packetsReceived": 100, "packetsLost": 0, "framesDecoded": 0])
+        let later = totals(15000, ["packetsReceived": 400, "packetsLost": 0, "framesDecoded": 150])
+        #expect(MeshReceivers.reading(sid: "TR", video: true, prev: first, now: later) == .init(sid: "TR", kind: "video", fps: 15, lost: 0))
+    }
+
+    // 1.0.8 (rtc-client 1.0.17), 2026-10-24: a browser tab in the background for 16 s, its videos turned off by the
+    // page, showed in the live view as "paused 1× 16.1 s" and "stutters ±870 ms". WebRTC adds a gap to the sum of the
+    // gaps and to their squares whatever it was, a pause's and a freeze's too, as its very length (VideoQualityObserver2).
+    private func readOn(_ at: Double, _ values: [String: Double]) -> MeshReceivers.Totals {
+        MeshReceivers.totals(values.mapValues { NSNumber(value: $0) }, at: at, readAt: at)
+    }
+
+    private var beforeTheGap: MeshReceivers.Totals {
+        readOn(10000, ["packetsReceived": 1000, "framesDecoded": 300, "totalInterFrameDelay": 10, "totalSquaredInterFrameDelay": 0.5,
+                     "pauseCount": 0, "totalPausesDuration": 0, "freezeCount": 0, "totalFreezesDuration": 0])
+    }
+
+    /// turned off at 2 s, back on at 18 s, its first frame at 18.1 s: one gap of 16.1 s, then 50 gaps at 30 and 50 ms
+    /// in turn (2 s, 0.085 s², a spread of 10 ms)
+    private var backAfterAPause: MeshReceivers.Totals {
+        readOn(20000, ["packetsReceived": 2000, "framesDecoded": 351, "totalInterFrameDelay": 10 + 16.1 + 2,
+                     "totalSquaredInterFrameDelay": 0.5 + 16.1 * 16.1 + 0.085, "pauseCount": 1, "totalPausesDuration": 16.1,
+                     "freezeCount": 0, "totalFreezesDuration": 0])
+    }
+
+    @Test func aPauseTheDeviceMadeIsToldApart() throws {
+        let read = try #require(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: backAfterAPause, resumedAt: 18000))
+        #expect(read.hiddenGaps == 1)
+        #expect(read.hiddenGapMs == 16100)
+        #expect(read.pauses == nil && read.pauseMs == nil)
+        #expect(read.freezes == 0 && read.freezeMs == 0)
+        #expect((9 ... 11).contains(read.unevenMs ?? -1))
+        // a turn-on just before the last reading: its first frame came after it
+        #expect(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: backAfterAPause, resumedAt: 9000)?.hiddenGaps == 1)
+    }
+
+    @Test func aPauseOfAVideoTheDeviceDidNotTurnOffIsTheCalls() throws {
+        let read = try #require(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: backAfterAPause))
+        #expect(read.pauses == 1 && read.pauseMs == 16100)
+        #expect(read.hiddenGaps == nil)
+        #expect((read.unevenMs ?? 0) > 2000)
+        // turned back on long before the last reading: that gap was the last reading's
+        #expect(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: backAfterAPause, resumedAt: 5000)?.pauses == 1)
+    }
+
+    @Test func aGapTooShortForAPauseIsToldApartFromTheFreezes() throws {
+        // off at 16.2 s, on at 18 s: one gap of 1.8 s counted as a freeze, then 205 gaps of 40 ms
+        let after = readOn(20000, ["packetsReceived": 2000, "framesDecoded": 300 + 206, "totalInterFrameDelay": 10 + 1.8 + 205 * 0.04,
+                                 "totalSquaredInterFrameDelay": 0.5 + 1.8 * 1.8 + 205 * 0.0016, "pauseCount": 0,
+                                 "totalPausesDuration": 0, "freezeCount": 1, "totalFreezesDuration": 1.8])
+        let read = try #require(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: after, resumedAt: 18000))
+        #expect(read.hiddenGaps == 1 && read.hiddenGapMs == 1800)
+        #expect(read.freezes == 0 && read.freezeMs == 0)
+        #expect(read.unevenMs == 0)
+    }
+
+    @Test func theSpreadIsUnsaidWhenTheGapIsNotKnown() throws {
+        // two pauses: which gaps they were the totals can't say
+        let two = readOn(20000, ["packetsReceived": 2000, "framesDecoded": 320, "totalInterFrameDelay": 19.5,
+                               "totalSquaredInterFrameDelay": 0.5 + 16 + 25 + 0.1, "pauseCount": 2, "totalPausesDuration": 9,
+                               "freezeCount": 0, "totalFreezesDuration": 0])
+        let read = try #require(MeshReceivers.reading(sid: "TR_v", video: true, prev: beforeTheGap, now: two, resumedAt: 18000))
+        #expect(read.hiddenGaps == 2 && read.hiddenGapMs == 9000)
+        #expect(read.pauses == nil && read.unevenMs == nil)
+        // a device that counts no pauses or freezes
+        let none = try #require(MeshReceivers.reading(
+            sid: "TR_v", video: true,
+            prev: readOn(10000, ["packetsReceived": 1000, "framesDecoded": 300, "totalInterFrameDelay": 10, "totalSquaredInterFrameDelay": 0.5]),
+            now: readOn(20000, ["packetsReceived": 2000, "framesDecoded": 351, "totalInterFrameDelay": 28.1,
+                                   "totalSquaredInterFrameDelay": 0.5 + 16.1 * 16.1 + 0.085]),
+            resumedAt: 18000,
+        ))
+        #expect(none.unevenMs == nil && none.hiddenGaps == nil)
+    }
+
+    @Test func theDeviceKeepsWhenItTurnedAVideoOffAndOn() {
+        var turns = RemoteTrackPublication.MeshTurns()
+        turns.sent(enabled: true, at: 1000)
+        #expect(turns.offAt == nil && turns.onAt == nil)
+        turns.sent(enabled: false, at: 2000)
+        // a size change while off isn't a new turn-off
+        turns.sent(enabled: false, at: 3000)
+        #expect(turns.offAt == 2000)
+        turns.sent(enabled: true, at: 18000)
+        #expect(turns.offAt == nil && turns.onAt == 18000)
+        turns.sent(enabled: true, at: 19000)
+        #expect(turns.onAt == 18000)
+    }
+
+    /// The report where a node reads it: a request with no message, the JSON in its field 1002.
+    @Test func receiversInASignalRequest() throws {
+        let json = try #require(MeshReceivers.json([.init(sid: "TR_v", kind: "video", fps: 30)]))
+        #expect(String(decoding: json, as: UTF8.self) == #"{"tracks":[{"fps":30,"kind":"video","sid":"TR_v"}]}"#)
+        let bytes = Mesh.lengthDelimited(MeshReceivers.field, json)
+        let request = try Livekit_SignalRequest(serializedBytes: bytes)
+        #expect(request.message == nil, "no message of LiveKit's")
+        #expect(Mesh.lengthDelimitedField(MeshReceivers.field, in: bytes) == json)
+    }
+}
